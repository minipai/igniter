{
  "name": "@minipai/igniter",
  "version": "0.1.0",
  "description": "Coordinate Linear tickets and coding agents through a local Bun service and Herdr.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minipai/igniter.git"
  },
  "homepage": "https://github.com/minipai/igniter#readme",
  "bugs": {
    "url": "https://github.com/minipai/igniter/issues"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.3.11"
  },
  "bin": {
    "igniter": "./src/cli.ts"
  },
  "files": [
    "src/",
    "!src/**/*.test.ts",
    "!src/e2e/",
    "!src/**/fake-*.ts",
    "!src/herdr/generate-types.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "serve": "bun src/cli.ts serve",
    "typecheck": "tsc --noEmit",
    "generate:herdr": "bun src/herdr/generate-types.ts",
    "test": "bun test src/package.test.ts src/cli.test.ts src/server src/herdr src/dispatch src/commander src/github",
    "test:e2e": "bun src/e2e/run.ts",
    "check": "bun run typecheck && bun run test && bun run test:e2e"
  },
  "dependencies": {
    "typebox": "1.3.25"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "bun-types": "1.4.0",
    "typescript": "7.0.2"
  }
}
