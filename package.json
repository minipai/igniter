{
  "name": "igniter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "igniter": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun src/cli.ts dev",
    "dev:web": "vite",
    "dev:api": "bun src/cli.ts serve --port 3457",
    "build": "vite build",
    "serve": "bun src/cli.ts serve",
    "typecheck": "tsc --noEmit",
    "generate:herdr": "bun src/herdr/generate-types.ts",
    "test": "bun test src/cli.test.ts src/server src/herdr src/dispatch src/stage src/commander",
    "test:ui": "vitest run",
    "check": "bun run typecheck && bun run test && bun run test:ui"
  },
  "dependencies": {
    "@solidjs/router": "2.0.0-next.21",
    "@solidjs/web": "2.0.0-rc.6",
    "basecoat-css": "1.0.2",
    "solid-js": "2.0.0-rc.6",
    "typebox": "1.3.25"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.38",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.1",
    "bun-types": "1.4.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
